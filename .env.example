# Copy to .env (never commit it) or set these in Vercel > Project > Settings > Environment Variables.
# Qloo hackathon key (only works against https://hackathon.api.qloo.com)
QLOO_API_KEY=
# Optional override, defaults to https://hackathon.api.qloo.com
QLOO_BASE_URL=
# Optional free-tier LLM. Set ONE of these. With neither, a deterministic template writes the text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Force stand-in data even when a key is set (1 = on)
MOCK_QLOO=
# Optional private saved readings for the suggested examples (server-side only, never commit Qloo data)
EXAMPLE_CACHE=
